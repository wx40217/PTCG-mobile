<?xml version="1.0" encoding="utf-8"?>
<!--
  开发配置（仅 debug 变体）：允许局域网明文，便于手机直连本机开发服务。
  该文件不会参与 release 构建。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
